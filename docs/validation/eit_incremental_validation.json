    "source": "import argparse, importlib.util, json, sys, time\nfrom pathlib import Path\nimport torch\nfrom tensordict import TensorDict\n\nparser=argparse.ArgumentParser()\nparser.add_argument(\"--baseline\",action=\"store_true\")\nparser.add_argument(\"--output\",required=True)\nargs=parser.parse_args()\ntorch.set_num_threads(1)\nif args.baseline:\n  spec=importlib.util.spec_from_file_location(\"replay_baseline\",\"/tmp/eit-replay-baseline.py\")\n  mod=importlib.util.module_from_spec(spec)\n  sys.modules[spec.name]=mod\n  spec.loader.exec_module(mod)\nelse:\n  import supermimic.replay_buffer as mod\nE,T=2048,1000\nschema={\"state\":mod.FieldSpec(71),\"action\":mod.FieldSpec(29),\"sim_ctx\":mod.FieldSpec(2),\n        \"episode_id\":mod.FieldSpec(dtype=torch.long),\"time_index\":mod.FieldSpec(dtype=torch.long),\n        \"terminated\":mod.FieldSpec(dtype=torch.bool),\"truncated\":mod.FieldSpec(dtype=torch.bool)}\nreplay=mod.ReplayBuffer(schema,T,E,device=\"cuda\",replay_mode=\"model\")\nstate=torch.zeros(E,71,device=\"cuda\");state[:,3]=1\nframe=TensorDict({\"state\":state,\"action\":torch.zeros(E,29,device=\"cuda\"),\n \"sim_ctx\":torch.zeros(E,2,device=\"cuda\"),\"episode_id\":torch.arange(E,device=\"cuda\"),\n \"time_index\":torch.zeros(E,dtype=torch.long,device=\"cuda\"),\n \"terminated\":torch.zeros(E,dtype=torch.bool,device=\"cuda\"),\n \"truncated\":torch.zeros(E,dtype=torch.bool,device=\"cuda\")},[E])\ntorch.cuda.synchronize();begin=time.perf_counter();samples=[]\nfor step in range(1100):\n  frame[\"time_index\"].fill_(step)\n  frame[\"state\"][:,7]=step\n  replay.insert(frame)\n  replay.finish_collection_round()\n  if (step+1)%100==0:\n    starts=replay.model_window_starts([0],8)\n    assert starts.shape==(min(step+1,T)-7,2)\n    first_time=int(replay.model_windows(starts[:1],8)[\"state\"][0,0,7])\n    assert first_time==max(0,step+1-T)\n    del starts\n    torch.cuda.synchronize()\n    r={\"step\":step+1,\"elapsed_seconds\":time.perf_counter()-begin,\n       \"allocated\":torch.cuda.memory_allocated(),\"reserved\":torch.cuda.memory_reserved(),\n       \"peak_allocated\":torch.cuda.max_memory_allocated(),\n       \"peak_reserved\":torch.cuda.max_memory_reserved(),\n       \"allocation_retries\":torch.cuda.memory_stats()[\"num_alloc_retries\"]}\n    samples.append(r);print(json.dumps(r),flush=True)\nPath(args.output).write_text(json.dumps({\"baseline\":args.baseline,\"num_envs\":E,\"capacity\":T,\"samples\":samples},indent=2))\n"
  },
